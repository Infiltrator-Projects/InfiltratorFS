.DEFAULT_GOAL := all
# Experimental independent Format 0.19 EFI filesystem driver.
# Single format authority: InfiltratorFS's existing include/ and src/ trees.
SRCDIR = .
HOSTARCH = $(shell uname -m)
VPATH = .:platform:../../src:../../src/infiltratr-common/src:lz4
LOCAL_GNUEFI_CFLAGS = -DFSTYPE=infiltratorfs -I. -I../../include -I../../src/infiltratr-common/include -Ilz4 \
 -ffreestanding -fno-builtin -ffunction-sections -fdata-sections -fvisibility=hidden \
 -U_FORTIFY_SOURCE -D_FORTIFY_SOURCE=0 -include platform/uefi_libc.h \
 -DLZ4_FREESTANDING=1 -DLZ4_memcpy=memcpy -DLZ4_memset=memset -DLZ4_memmove=memmove \
 "-DEFIAPI=__attribute__((ms_abi))"
# Link only the reachable freestanding portable reader: the shared source
# also contains unrelated host CLI helpers that intentionally require libc.
LOCAL_GNUEFI_LDFLAGS = --gc-sections
OBJS = fsw_core.o fsw_efi.o fsw_efi_lib.o fsw_lib.o fsw_infiltratorfs.o \
 uefi_compat.o checksum.o locator.o status.o storage.o security.o fs.o volume.o \
 arithmetic.o core.o lz4.o
TARGET = InfiltratorFS_x64.efi

ifeq ($(INFS_UEFI_TRACE),1)
LOCAL_GNUEFI_CFLAGS += -DINFS_UEFI_TRACE=1
endif

include ../Make.common

# GNU-EFI's stock linker script does not root the standalone .reloc input
# section. With --gc-sections (required to exclude unrelated libc-dependent
# code from the shared portable core), GNU ld discards .reloc and objcopy
# emits IMAGE_FILE_RELOCS_STRIPPED with no PE base relocation directory.
# OVMF then cannot safely relocate/load this EFI driver.
# Derive a script from the host GNU-EFI toolchain rather than copying its
# architecture-specific rules; preserve .reloc as a GC root only.
GNUEFI_KEEP_RELOC_SCRIPT := $(CURDIR)/gnu-efi-keep-reloc.lds
GNUEFI_LDSCRIPT := $(GNUEFI_KEEP_RELOC_SCRIPT)

$(GNUEFI_KEEP_RELOC_SCRIPT): $(EFICRT0)/elf_$(ARCH)_efi.lds
	sed 's@\*[(]\.reloc[)]@KEEP(*(.reloc))@g' "$<" > "$@"
	grep -Fq 'KEEP(*(.reloc))' "$@"

all: $(TARGET)

$(SHLIB_TARGET): $(OBJS) $(GNUEFI_KEEP_RELOC_SCRIPT)
	$(LD) $(GNUEFI_LDFLAGS) $(LOCAL_GNUEFI_LDFLAGS) $(SUBSYSTEM_LDFLAG) $(OBJS) -o $@ $(LOCAL_LIBS) $(GNUEFI_LIBS)

$(TARGET): $(SHLIB_TARGET)
	$(OBJCOPY) -j .text -j .sdata -j .data -j .dynamic -j .dynsym -j .rodata \
	 -j .rel -j .rela -j .rel.* -j .rela.* -j .rel* -j .rela* \
	 -j .reloc --strip-unneeded $(FORMAT_DRIVER) $< $@
# Do not inject .sbat with an artificial +0x10000000 section VMA:
# it can inflate the PE SizeOfImage and make firmware reject allocation.
# Restore signed-image metadata only with a compact, validated section layout.
	chmod a-x $(TARGET)

clean:
	rm -f $(TARGET) $(SHLIB_TARGET) $(OBJS) $(GNUEFI_KEEP_RELOC_SCRIPT)
