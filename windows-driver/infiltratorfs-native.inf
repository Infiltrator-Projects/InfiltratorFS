[Version]
Signature="$WINDOWS NT$"
Class=InfiltratorFS
ClassGuid={099E2F6B-75F8-4ED7-8C04-6B21F7749206}
Provider=%ProviderName%
DriverVer=09/26/2026,0.18.94.0
CatalogFile=infiltratorfs-native.cat
PnpLockdown=1

[DestinationDirs]
DriverCopyFiles=13

[SourceDisksNames]
1=%Disk1%,,,

[SourceDisksFiles]
infiltratorfs-native.sys=1,,

[DefaultInstall.NTamd64]
OptionDesc=%ServiceDescription%
CopyFiles=DriverCopyFiles

[DefaultInstall.NTamd64.Services]
AddService=InfiltratorFS,0x00000002,InfiltratorFS_Service

[DriverCopyFiles]
infiltratorfs-native.sys

[InfiltratorFS_Service]
DisplayName=%ServiceName%
Description=%ServiceDescription%
ServiceType=2
StartType=3
ErrorControl=1
ServiceBinary=%13%\infiltratorfs-native.sys
LoadOrderGroup=File System

[Strings]
ProviderName="Infiltrator Projects"
Disk1="InfiltratorFS Native Filesystem Driver"
ServiceName="InfiltratorFS"
ServiceDescription="Native InfiltratorFS Windows filesystem driver"
