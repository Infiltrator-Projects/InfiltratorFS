# SPDX-License-Identifier: GPL-3.0-or-later
#
# Teach the normal Linux storage stack about InfiltratorFS volumes.  The
# portable inspector performs a bounded read-only probe and exports the same
# ID_FS_* properties that blkid normally supplies for established filesystems.
# Running before the persistent-storage rules also allows normal by-label and
# by-uuid links to be created from those properties.
#
# IMPORT{program} does not implicitly remove values imported by an earlier
# event when a later probe returns "not this filesystem".  UDisks deliberately
# waits for ID_FS_TYPE to become empty after its initial format wipe, so clear
# only properties belonging to a previously identified InfiltratorFS volume
# before re-probing.  A still-valid InfiltratorFS volume immediately repopulates
# them on the next IMPORT line.
ACTION=="add|change", SUBSYSTEM=="block", ENV{ID_FS_TYPE}=="infiltratorfs", ENV{ID_FS_USAGE}="", ENV{ID_FS_TYPE}="", ENV{ID_FS_VERSION}="", ENV{ID_FS_UUID}="", ENV{ID_FS_UUID_ENC}="", ENV{ID_FS_LABEL}="", ENV{ID_FS_LABEL_ENC}="", ENV{ID_FS_BLOCK_SIZE}="", ENV{UDISKS_NAME}="", ENV{UDISKS_ICON_NAME}="", ENV{UDISKS_SYMBOLIC_ICON_NAME}="", ENV{UDISKS_MOUNT_OPTIONS_DEFAULTS}="", ENV{UDISKS_MOUNT_OPTIONS_ALLOW}=""

ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="partition", IMPORT{program}="/usr/bin/infilfs-inspect --udev /dev/%k"
ACTION=="add|change", SUBSYSTEM=="block", ENV{DEVTYPE}=="disk", IMPORT{program}="/usr/bin/infilfs-inspect --udev /dev/%k"

# Keep the kernel filesystem registered before desktop mount requests are
# validated by UDisks.  mount.infiltratorfs uses this native filesystem only;
# a modprobe failure therefore remains visible to the desktop mount request.
ENV{ID_FS_TYPE}=="infiltratorfs", RUN+="/sbin/modprobe -q infiltratorfs"

# Give UDisks/GVfs a useful presentation name when a volume has no explicit
# filesystem label.  A real on-disk label remains authoritative and is not
# overridden.  The long "Contents" filesystem description shown by GNOME
# Disks is generated inside libudisks2 from its filesystem-name table; see
# packaging/udisks2-infiltratorfs-display.patch for the corresponding upstream
# mapping required to replace "Unknown (infiltratorfs 0.12)" there.
ENV{ID_FS_TYPE}=="infiltratorfs", ENV{ID_FS_LABEL}=="", ENV{UDISKS_NAME}="InfiltratorFS"
ENV{ID_FS_TYPE}=="infiltratorfs", ENV{UDISKS_ICON_NAME}="drive-harddisk"
ENV{ID_FS_TYPE}=="infiltratorfs", ENV{UDISKS_SYMBOLIC_ICON_NAME}="drive-harddisk-symbolic"

# UDisks applies these only to devices that the probe identified as
# InfiltratorFS.  The set deliberately sticks to generic VFS-safe options.
ENV{ID_FS_TYPE}=="infiltratorfs", ENV{UDISKS_MOUNT_OPTIONS_DEFAULTS}="nodev,nosuid"
ENV{ID_FS_TYPE}=="infiltratorfs", ENV{UDISKS_MOUNT_OPTIONS_ALLOW}="exec,noexec,nodev,nosuid,atime,noatime,nodiratime,relatime,strictatime,lazytime,ro,rw,sync,dirsync,nosymfollow"
