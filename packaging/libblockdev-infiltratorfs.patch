From: InfiltratorFS project
Subject: [PATCH] fs: add InfiltratorFS formatter support

Validated against upstream libblockdev commit
7ce6c6e9b59fdf16cd5dffd602f954ef52588dbb (2026-08-31).

Expose InfiltratorFS through the generic filesystem plugin so UDisks can
discover mkfs.infiltratorfs, report its creation features and invoke it.
libblockdev mkfs requests are already explicit destructive operations, so
the adapter supplies the formatter's required --force acknowledgement.

diff --git a/src/lib/plugin_apis/fs.api b/src/lib/plugin_apis/fs.api
--- a/src/lib/plugin_apis/fs.api
+++ b/src/lib/plugin_apis/fs.api
@@ -528,6 +528,7 @@ typedef enum {
     BD_FS_TECH_EXFAT,
     BD_FS_TECH_BTRFS,
     BD_FS_TECH_UDF,
+    BD_FS_TECH_INFILTRATORFS,
 } BDFSTech;
 
 typedef enum {
diff --git a/src/plugins/fs.c b/src/plugins/fs.c
--- a/src/plugins/fs.c
+++ b/src/plugins/fs.c
@@ -125,6 +125,30 @@ gboolean bd_fs_is_tech_avail (BDFSTech tech, guint64 mode, GError **error) {
             return bd_fs_btrfs_is_tech_avail (tech, mode, error);
         case BD_FS_TECH_UDF:
             return bd_fs_udf_is_tech_avail (tech, mode, error);
+        case BD_FS_TECH_INFILTRATORFS: {
+            const guint64 supported =
+                BD_FS_TECH_MODE_MKFS | BD_FS_TECH_MODE_CHECK |
+                BD_FS_TECH_MODE_REPAIR | BD_FS_TECH_MODE_RESIZE;
+            if (mode & ~supported) {
+                g_set_error_literal (error, BD_FS_ERROR,
+                                     BD_FS_ERROR_TECH_UNAVAIL,
+                                     "Requested InfiltratorFS operation is not available.");
+                return FALSE;
+            }
+            if ((mode & BD_FS_TECH_MODE_MKFS) &&
+                !bd_utils_check_util_version ("mkfs.infiltratorfs", NULL,
+                                              "", NULL, error))
+                return FALSE;
+            if ((mode & (BD_FS_TECH_MODE_CHECK | BD_FS_TECH_MODE_REPAIR)) &&
+                !bd_utils_check_util_version ("fsck.infiltratorfs", NULL,
+                                              "", NULL, error))
+                return FALSE;
+            if ((mode & BD_FS_TECH_MODE_RESIZE) &&
+                !bd_utils_check_util_version ("infiltratorfs-resize", NULL,
+                                              "", NULL, error))
+                return FALSE;
+            return TRUE;
+        }
         /* coverity[dead_error_begin] */
         default:
             /* this should never be reached (see the comparison with LAST_FS
diff --git a/src/plugins/fs.h b/src/plugins/fs.h
--- a/src/plugins/fs.h
+++ b/src/plugins/fs.h
@@ -23,7 +23,7 @@ typedef enum {
 
 /* XXX: where the file systems start at the enum of technologies */
 #define BD_FS_OFFSET 2
-#define BD_FS_LAST_FS 13
+#define BD_FS_LAST_FS 14
 typedef enum {
     BD_FS_TECH_GENERIC  = 0,
     BD_FS_TECH_MOUNT    = 1,
@@ -38,6 +38,7 @@ typedef enum {
     BD_FS_TECH_EXFAT    = 10,
     BD_FS_TECH_BTRFS    = 11,
     BD_FS_TECH_UDF      = 12,
+    BD_FS_TECH_INFILTRATORFS = 13,
 } BDFSTech;
 
 /* XXX: number of the highest bit of all modes */
diff --git a/src/plugins/fs/generic.c b/src/plugins/fs/generic.c
--- a/src/plugins/fs/generic.c
+++ b/src/plugins/fs/generic.c
@@ -174,6 +174,16 @@ static const BDFSFeatures fs_features[BD_FS_LAST_FS] = {
       .partition_type = "ebd0a0a2-b9e5-4433-87c0-68b6b72699c7",
       .min_size = 2 MiB,
       .max_size = 16 TiB },
+    /* INFILTRATORFS */
+    { .resize = BD_FS_ONLINE_GROW | BD_FS_ONLINE_SHRINK,
+      .mkfs = BD_FS_MKFS_LABEL | BD_FS_MKFS_FORCE,
+      .fsck = BD_FS_FSCK_CHECK | BD_FS_FSCK_REPAIR,
+      .configure = 0,
+      .features = BD_FS_FEATURE_OWNERS,
+      .partition_id = "0x83",
+      .partition_type = "0fc63daf-8483-4772-8e79-3d69d8477de4",
+      .min_size = 16 MiB,
+      .max_size = 16 EiB - 1 },
 };
 
 /**
@@ -312,6 +322,16 @@ const BDFSInfo fs_info[BD_FS_LAST_FS] = {
       .label_util = "udflabel",
       .info_util = "udfinfo",
       .uuid_util = "udflabel" },
+    /* INFILTRATORFS */
+    { .type = "infiltratorfs",
+      .mkfs_util = "mkfs.infiltratorfs",
+      .check_util = "fsck.infiltratorfs",
+      .repair_util = "fsck.infiltratorfs",
+      .resize_util = "infiltratorfs-resize",
+      .minsize_util = NULL,
+      .label_util = NULL,
+      .info_util = NULL,
+      .uuid_util = NULL },
 };
 
 /**
@@ -366,6 +386,48 @@ static BDFSTech fstype_to_tech (const gchar *fstype) {
         return BD_FS_TECH_BTRFS;
     } else if (g_strcmp0 (fstype, "udf") == 0) {
         return BD_FS_TECH_UDF;
+    } else if (g_strcmp0 (fstype, "infiltratorfs") == 0) {
+        return BD_FS_TECH_INFILTRATORFS;
     } else {
         return BD_FS_TECH_GENERIC;
     }
+
+static gboolean infiltratorfs_check_or_repair (const gchar *device,
+                                                gboolean repair,
+                                                GError **error) {
+    const gchar *args[] = {
+        "fsck.infiltratorfs", repair ? "-p" : "-n", device, NULL
+    };
+    return bd_utils_exec_and_report_error (args, NULL, error);
+}
+
+static gboolean infiltratorfs_resize_device (const gchar *device,
+                                              guint64 new_size,
+                                              GError **error) {
+    g_autofree gchar *mountpoint = NULL;
+    g_autofree gchar *size_text = NULL;
+    gboolean unmount = FALSE;
+    gboolean success = FALSE;
+    gboolean unmount_ok = TRUE;
+    GError *local_error = NULL;
+
+    mountpoint = fs_mount (device, "infiltratorfs", FALSE, &unmount, error);
+    if (!mountpoint)
+        return FALSE;
+    size_text = new_size == 0 ?
+        g_strdup ("max") : g_strdup_printf ("%" G_GUINT64_FORMAT, new_size);
+    const gchar *args[] = {
+        "infiltratorfs-resize", mountpoint, size_text, NULL
+    };
+    success = bd_utils_exec_and_report_error (args, NULL, error);
+    if (unmount) {
+        unmount_ok = fs_unmount (device, mountpoint, "resizing", &local_error);
+        if (!unmount_ok) {
+            if (success)
+                g_propagate_error (error, local_error);
+            else
+                g_clear_error (&local_error);
+        }
+    }
+    return success && unmount_ok;
+}
@@ -440,4 +480,15 @@ static gboolean device_operation (const gchar *device, const gchar *fstype, BDFS
         }
+    } else if (g_strcmp0 (detected_fstype, "infiltratorfs") == 0) {
+        switch (op) {
+            case BD_FS_RESIZE:
+                return infiltratorfs_resize_device (device, new_size, error);
+            case BD_FS_REPAIR:
+                return infiltratorfs_check_or_repair (device, TRUE, error);
+            case BD_FS_CHECK:
+                return infiltratorfs_check_or_repair (device, FALSE, error);
+            default:
+                break;
+        }
     }
 
     switch (op) {
@@ -523,4 +545,37 @@ gboolean bd_fs_clean (const gchar *device, gboolean force, GError **error) {
   gboolean ret = FALSE;
   GError *l_error = NULL;
+  gchar *infiltrator_mkfs = NULL;
+
+  /*
+   * libblkid does not yet know the InfiltratorFS signature, but UDisks calls
+   * bd_fs_clean() before every mkfs and then waits for the old filesystem
+   * identity to disappear.  Give the bundled filesystem plugin a narrow
+   * bridge: mkfs.infiltratorfs --wipe-only positively identifies the existing
+   * format before clearing its distributed checkpoints. Exit status 3 means
+   * "not InfiltratorFS" and falls through to libblkid's normal cleaner.
+   */
+  infiltrator_mkfs = g_find_program_in_path ("mkfs.infiltratorfs");
+  if (infiltrator_mkfs != NULL) {
+      const gchar *wipe_args[] = {
+          infiltrator_mkfs, "--force", "--wipe-only", device, NULL
+      };
+      gint wipe_status = 0;
+      GError *wipe_error = NULL;
+
+      if (!bd_utils_exec_and_report_status_error (
+              wipe_args, NULL, &wipe_status, &wipe_error)) {
+          if (wipe_status == 3) {
+              /* Exit 3 is the helper's positive "not InfiltratorFS" result. */
+              g_clear_error (&wipe_error);
+          } else {
+              g_free (infiltrator_mkfs);
+              g_prefix_error (&wipe_error,
+                              "Failed to clear InfiltratorFS signatures: ");
+              g_propagate_error (error, wipe_error);
+              return FALSE;
+          }
+      }
+      g_free (infiltrator_mkfs);
+  }
 
   ret = bd_fs_wipe (device, TRUE, force, &l_error);
@@ -2006,6 +2028,26 @@ extern BDExtraArg** bd_fs_xfs_mkfs_options (BDFSMkfsOptions *options, const BDEx
 extern BDExtraArg** bd_fs_btrfs_mkfs_options (BDFSMkfsOptions *options, const BDExtraArg **extra);
 extern BDExtraArg** bd_fs_udf_mkfs_options (BDFSMkfsOptions *options, const BDExtraArg **extra);
 
+static BDExtraArg** bd_fs_infiltratorfs_mkfs_options (BDFSMkfsOptions *options,
+                                                       const BDExtraArg **extra) {
+    GPtrArray *options_array = g_ptr_array_new ();
+    const BDExtraArg **extra_p = NULL;
+
+    /* mkfs.infiltratorfs deliberately requires --force for block devices.
+     * A libblockdev mkfs request is already an explicit destructive format
+     * operation, so always supply it at this boundary. */
+    g_ptr_array_add (options_array, bd_extra_arg_new ("--force", ""));
+    if (options->label && g_strcmp0 (options->label, "") != 0)
+        g_ptr_array_add (options_array, bd_extra_arg_new ("-L", options->label));
+    if (extra) {
+        for (extra_p = extra; *extra_p; extra_p++)
+            g_ptr_array_add (options_array,
+                             bd_extra_arg_copy ((BDExtraArg *) *extra_p));
+    }
+    g_ptr_array_add (options_array, NULL);
+    return (BDExtraArg **) g_ptr_array_free (options_array, FALSE);
+}
+
 /**
  * bd_fs_mkfs:
  * @device: the device to create the new filesystem on
@@ -2068,6 +2110,11 @@ gboolean bd_fs_mkfs (const gchar *device, const gchar *fstype, BDFSMkfsOptions *
     } else if (g_strcmp0 (fstype, "udf") == 0) {
         extra_args = bd_fs_udf_mkfs_options (options, extra);
         ret = bd_fs_udf_mkfs (device, NULL, NULL, 0, (const BDExtraArg **) extra_args, error);
+    } else if (g_strcmp0 (fstype, "infiltratorfs") == 0) {
+        const gchar *args[3] = {"mkfs.infiltratorfs", device, NULL};
+        extra_args = bd_fs_infiltratorfs_mkfs_options (options, extra);
+        ret = bd_utils_exec_and_report_error (
+            args, (const BDExtraArg **) extra_args, error);
     } else {
         g_set_error (error, BD_FS_ERROR, BD_FS_ERROR_NOT_SUPPORTED,
                      "Filesystem '%s' is not supported.", fstype);
