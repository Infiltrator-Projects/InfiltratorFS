From: InfiltratorFS project
Subject: [PATCH] disks: offer InfiltratorFS in the format menu

Validated against upstream gnome-disk-utility commit
dc2da843a7afc7f9e916999d5daeecb0d6adf84c (2026-08-31).

GNOME Disks maintains an explicit list for the "Other" filesystem page; a
libblockdev formatter alone cannot make a new filesystem appear there. Add
InfiltratorFS to that list. Availability still comes from UDisks/libblockdev,
so the entry is disabled when mkfs.infiltratorfs is not installed.

diff --git a/src/disks/gdu-create-other-page.c b/src/disks/gdu-create-other-page.c
--- a/src/disks/gdu-create-other-page.c
+++ b/src/disks/gdu-create-other-page.c
@@ -37,6 +37,7 @@ G_DEFINE_ENUM_TYPE (GduOtherFsType, gdu_other_fs_type, G_DEFINE_ENUM_VALUE (GDU_
                     G_DEFINE_ENUM_VALUE (GDU_OTHER_FS_TYPE_F2FS, "f2fs"),
                     G_DEFINE_ENUM_VALUE (GDU_OTHER_FS_TYPE_EXFAT, "exfat"),
                     G_DEFINE_ENUM_VALUE (GDU_OTHER_FS_TYPE_UDF, "udf"),
+                    G_DEFINE_ENUM_VALUE (GDU_OTHER_FS_TYPE_INFILTRATORFS, "infiltratorfs"),
                     G_DEFINE_ENUM_VALUE (GDU_OTHER_FS_TYPE_EMPTY, "empty"));
 
 static void
@@ -157,6 +158,7 @@ gdu_create_other_page_new (UDisksClient *client)
               { N_("F2FS"), N_("Flash Storage Linux Filesystem") },
                 { N_("exFAT"), N_("Flash Storage Windows Filesystem, used on SDXC cards") },
                   { N_("UDF"), N_("Universal Disk Format, for removable devices on many systems") },
+                    { N_("InfiltratorFS"), N_("Portable checksummed copy-on-write filesystem") },
                     { N_("No Filesystem"), NULL } };
 
     self = g_object_new (GDU_TYPE_CREATE_OTHER_PAGE, NULL);
@@ -206,7 +207,15 @@ row_adder (GduCreateOtherPage *page, gboolean tested, gboolean available, gchar
     {
       gchar *s;
 
       gtk_widget_set_sensitive (GTK_WIDGET (priv->prev_other_fs_radio), FALSE);
-      s = g_strdup_printf (_("The utility %s is missing."), missing_util);
+      if (g_strcmp0 (id, "infiltratorfs") == 0 && missing_util == NULL)
+        s = g_strdup (
+            _("InfiltratorFS formatter service is unavailable. Reinstall or repair InfiltratorFS."));
+      else
+        s = g_strdup_printf (_("The utility %s is missing."),
+                             missing_util ? missing_util : _("unknown"));
       gtk_widget_set_tooltip_text (GTK_WIDGET (priv->prev_other_fs_radio), s);
 
       g_free (s);

diff --git a/src/disks/gdu-create-other-page.h b/src/disks/gdu-create-other-page.h
--- a/src/disks/gdu-create-other-page.h
+++ b/src/disks/gdu-create-other-page.h
@@ -27,6 +27,7 @@ typedef enum {
     GDU_OTHER_FS_TYPE_F2FS,
     GDU_OTHER_FS_TYPE_EXFAT,
     GDU_OTHER_FS_TYPE_UDF,
+    GDU_OTHER_FS_TYPE_INFILTRATORFS,
     GDU_OTHER_FS_TYPE_EMPTY,
     N_OTHER_FS
 } GduOtherFsType;
