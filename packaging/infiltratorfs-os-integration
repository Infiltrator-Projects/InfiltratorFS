#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -Eeuo pipefail

readonly OWNER="infiltratorfs"
readonly BUNDLE="/usr/lib/infiltratorfs/os-integration"
readonly GDU_TARGET="/usr/bin/gnome-disks"
readonly MINT_UI="/usr/lib/mintstick/mintstick.py"
readonly MINT_FORMATTER="/usr/lib/mintstick/raw_format.py"
readonly MINT_NEMO_FORMAT="/usr/share/nemo/actions/mintstick-format.nemo_action"
readonly MINT_NEMO_FORMAT_STOCK="${MINT_NEMO_FORMAT}.infiltratorfs-stock"
readonly INFILTRATOR_NEMO_FORMAT="/usr/lib/infiltratorfs/infiltratorfs-format-partition.nemo_action"
readonly LEGACY_INFILTRATOR_NEMO_FORMAT="/usr/share/nemo/actions/infiltratorfs-format-partition.nemo_action"

log()
{
    printf 'InfiltratorFS desktop integration: %s\n' "$*"
}

diversion_for()
{
    dpkg-divert --list "$1" 2>/dev/null || true
}

is_our_diversion()
{
    diversion_for "$1" | grep -Fq "by ${OWNER}"
}

require_no_foreign_diversion()
{
    local path="$1" current
    current="$(diversion_for "$path")"
    if [[ -n "$current" ]] && ! grep -Fq "by ${OWNER}" <<<"$current"; then
        printf 'InfiltratorFS: refusing to replace %s because another package already diverts it:\n%s\n' \
            "$path" "$current" >&2
        return 1
    fi
}

divert_path()
{
    local path="$1" stock="$2"
    if is_our_diversion "$path"; then
        return 0
    fi
    require_no_foreign_diversion "$path"
    [[ -e "$path" || -L "$path" ]] || {
        printf 'InfiltratorFS: required desktop component is missing: %s\n' "$path" >&2
        return 1
    }
    dpkg-divert --package "$OWNER" --add --rename --divert "$stock" "$path" >/dev/null
}

restore_path()
{
    local path="$1" stock="$2"
    if ! is_our_diversion "$path"; then
        return 0
    fi
    rm -f -- "$path"
    dpkg-divert --package "$OWNER" --remove --rename --divert "$stock" "$path" >/dev/null
}

find_libblockdev_plugin()
{
    local candidate
    while IFS= read -r candidate; do
        case "$candidate" in
            */libbd_fs.so.[0-9]*.[0-9]*.[0-9]*)
                if [[ -e "$candidate" || -L "$candidate" ]]; then
                    printf '%s\n' "$candidate"
                    return 0
                fi
                ;;
        esac
    done < <(dpkg-query -L libblockdev-fs3 2>/dev/null || true)
    return 1
}

check_supported_stack()
{
    local gdu_version bd_version
    gdu_version="$(dpkg-query -W -f='${Version}' gnome-disk-utility 2>/dev/null || true)"
    bd_version="$(dpkg-query -W -f='${Version}' libblockdev-fs3 2>/dev/null || true)"
    case "$gdu_version" in
        46.*) ;;
        *)
            printf 'InfiltratorFS: bundled GNOME Disks integration requires 46.x; found %s.\n' \
                "${gdu_version:-none}" >&2
            return 1
            ;;
    esac
    case "$bd_version" in
        3.1.*) ;;
        *)
            printf 'InfiltratorFS: bundled libblockdev integration requires 3.1.x; found %s.\n' \
                "${bd_version:-none}" >&2
            return 1
            ;;
    esac
}

restart_udisks()
{
    if command -v systemctl >/dev/null 2>&1; then
        # A plain restart is deliberate here. try-restart can leave a stale
        # D-Bus-activated udisksd process alive with the stock libbd_fs plugin
        # mapped, which makes GNOME Disks report "The utility (null) is missing."
        systemctl restart udisks2.service >/dev/null 2>&1 ||
            systemctl try-restart udisks2.service >/dev/null 2>&1 || true
    elif command -v service >/dev/null 2>&1; then
        service udisks2 restart >/dev/null 2>&1 || true
    fi
}

udisks_can_format_infiltratorfs()
{
    local result
    command -v gdbus >/dev/null 2>&1 || return 1
    result="$(gdbus call --system         --dest org.freedesktop.UDisks2         --object-path /org/freedesktop/UDisks2/Manager         --method org.freedesktop.UDisks2.Manager.CanFormat infiltratorfs         2>/dev/null || true)"
    [[ "$result" == *"true"* ]]
}

wait_for_udisks_formatter()
{
    local attempt
    for attempt in $(seq 1 20); do
        if udisks_can_format_infiltratorfs; then
            return 0
        fi
        sleep 0.25
    done
    return 1
}

require_udisks_formatter()
{
    command -v mkfs.infiltratorfs >/dev/null 2>&1 || {
        echo 'InfiltratorFS: mkfs.infiltratorfs is not installed in PATH.' >&2
        return 1
    }

    if wait_for_udisks_formatter; then
        return 0
    fi

    # One explicit second restart covers package upgrades where udisksd was
    # simultaneously being D-Bus activated while the diverted plugin changed.
    restart_udisks
    if wait_for_udisks_formatter; then
        return 0
    fi

    echo 'InfiltratorFS: UDisks still does not advertise CanFormat(infiltratorfs) after the patched libblockdev plugin was installed.' >&2
    if command -v gdbus >/dev/null 2>&1; then
        gdbus call --system             --dest org.freedesktop.UDisks2             --object-path /org/freedesktop/UDisks2/Manager             --method org.freedesktop.DBus.Properties.Get             org.freedesktop.UDisks2.Manager SupportedFilesystems >&2 || true
    fi
    return 1
}

remove_all()
{
    local plugin="" line path

    restore_path "$MINT_FORMATTER" "${MINT_FORMATTER}.infiltratorfs-stock"
    restore_path "$MINT_UI" "${MINT_UI}.infiltratorfs-stock"
    restore_path "$MINT_NEMO_FORMAT" "$MINT_NEMO_FORMAT_STOCK"
    rm -f -- "$LEGACY_INFILTRATOR_NEMO_FORMAT"

    plugin="$(find_libblockdev_plugin || true)"
    if [[ -n "$plugin" ]]; then
        restore_path "$plugin" "${plugin}.infiltratorfs-stock"
    else
        while IFS= read -r line; do
            [[ "$line" == *"libbd_fs.so."*" by ${OWNER}"* ]] || continue
            path="${line#diversion of }"
            path="${path%% to *}"
            restore_path "$path" "${path}.infiltratorfs-stock"
        done < <(dpkg-divert --list 2>/dev/null || true)
    fi

    restore_path "$GDU_TARGET" "${GDU_TARGET}.infiltratorfs-stock"
    restart_udisks
    log "stock desktop components restored."
}

install_all()
{
    # InfiltratorFS must never integrate with Mintstick/Nemo's "USB Stick
    # Formatter". Mintstick is a whole-device repartitioner: it intentionally
    # replaces the partition table and creates one filesystem spanning the
    # selected drive. Older InfiltratorFS packages patched Mintstick and
    # normalised /dev/mmcblk0pN or /dev/nvme0n1pN to the parent disk, which
    # made a partition-looking desktop action destructive to every partition
    # on that device. Always undo that historical diversion before doing
    # anything else, including source-built packages with no desktop bundle.
    restore_path "$MINT_FORMATTER" "${MINT_FORMATTER}.infiltratorfs-stock"
    restore_path "$MINT_UI" "${MINT_UI}.infiltratorfs-stock"
    # Older InfiltratorFS packages installed a second Nemo action named
    # "Format partition as InfiltratorFS…".  The supported integration now
    # replaces Mint's existing Format action instead, so remove only our
    # legacy duplicate entry.
    rm -f -- "$LEGACY_INFILTRATOR_NEMO_FORMAT"

    if [[ ! -s "$BUNDLE/gnome-disks" ||
          ! -s "$BUNDLE/libbd_fs.so" ||
          ! -s "$BUNDLE/manifest" ]]; then
        # Source-built +native packages intentionally carry no distro binary
        # bundle. Do not disturb an integration installed by a release package.
        log "no distro integration bundle in this package; nothing to install."
        return 0
    fi

    check_supported_stack

    local plugin plugin_stock tmp=""
    plugin="$(find_libblockdev_plugin)" || {
        echo 'InfiltratorFS: could not locate the libblockdev filesystem plugin.' >&2
        return 1
    }
    plugin_stock="${plugin}.infiltratorfs-stock"

    require_no_foreign_diversion "$GDU_TARGET"
    require_no_foreign_diversion "$plugin"
    if [[ -e "$MINT_NEMO_FORMAT" || -L "$MINT_NEMO_FORMAT" ]]; then
        require_no_foreign_diversion "$MINT_NEMO_FORMAT"
    fi
    [[ -s "$INFILTRATOR_NEMO_FORMAT" ]] || {
        echo 'InfiltratorFS: partition-safe Nemo Format action is missing.' >&2
        return 1
    }

    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' RETURN

    trap 'remove_all; rm -rf "$tmp"' ERR

    divert_path "$GDU_TARGET" "${GDU_TARGET}.infiltratorfs-stock"
    install -m 0755 "$BUNDLE/gnome-disks" "$GDU_TARGET"

    divert_path "$plugin" "$plugin_stock"
    install -m 0644 "$BUNDLE/libbd_fs.so" "$plugin"

    # Mintstick's stock Nemo "Format" action opens a whole-device formatter.
    # Replace only that menu action (not Mintstick itself) with GNOME Disks'
    # --format-device entry point.  %D remains the exact selected partition,
    # so Nemo shows one Format item and the dialog offers InfiltratorFS along
    # with the normal filesystem choices without ever normalising to a parent
    # disk.
    if [[ -e "$MINT_NEMO_FORMAT" || -L "$MINT_NEMO_FORMAT" ||
          -e "$MINT_NEMO_FORMAT_STOCK" || -L "$MINT_NEMO_FORMAT_STOCK" ]]; then
        divert_path "$MINT_NEMO_FORMAT" "$MINT_NEMO_FORMAT_STOCK"
        install -m 0644 "$INFILTRATOR_NEMO_FORMAT" "$MINT_NEMO_FORMAT"
    fi

    restart_udisks
    require_udisks_formatter
    rm -rf "$tmp"
    trap - RETURN
    trap - ERR
    log "GNOME Disks, libblockdev and UDisks/GVfs partition-safe integration installed and formatter availability verified; Mintstick remains stock."
}

case "${1:-}" in
    install)
        install_all
        ;;
    remove)
        remove_all
        ;;
    verify)
        [[ -s "$BUNDLE/gnome-disks" && -s "$BUNDLE/libbd_fs.so" ]]
        is_our_diversion "$GDU_TARGET"
        plugin="$(find_libblockdev_plugin)"
        is_our_diversion "$plugin"
        grep -aFq 'InfiltratorFS' "$GDU_TARGET"
        grep -aFq 'infiltratorfs' "$plugin"
        if is_our_diversion "$MINT_NEMO_FORMAT"; then
            grep -Fq 'Name=Format' "$MINT_NEMO_FORMAT"
            grep -Fq 'Exec=/usr/bin/gnome-disks --block-device %D --format-device' "$MINT_NEMO_FORMAT"
            [[ ! -e "$LEGACY_INFILTRATOR_NEMO_FORMAT" ]]
        fi
        require_udisks_formatter
        ;;
    *)
        echo 'Usage: infiltratorfs-os-integration {install|remove|verify}' >&2
        exit 2
        ;;
esac
