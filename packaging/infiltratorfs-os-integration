#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# Legacy repair helper. Current packages never install, divert or replace
# UDisks, libblockdev, GNOME Disks or Mintstick files.
set -Eeuo pipefail
readonly OWNER="infiltratorfs"
readonly GDU_TARGET="/usr/bin/gnome-disks"
readonly MINT_UI="/usr/lib/mintstick/mintstick.py"
readonly MINT_FORMATTER="/usr/lib/mintstick/raw_format.py"
readonly MINT_NEMO_FORMAT="/usr/share/nemo/actions/mintstick-format.nemo_action"
readonly MINT_NEMO_FORMAT_STOCK="${MINT_NEMO_FORMAT}.infiltratorfs-stock"
readonly LEGACY_INFILTRATOR_NEMO_FORMAT="/usr/share/nemo/actions/infiltratorfs-format-partition.nemo_action"

log() { printf 'InfiltratorFS desktop integration: %s\n' "$*"; }
diversion_for() { dpkg-divert --list "$1" 2>/dev/null || true; }
is_our_diversion() { diversion_for "$1" | grep -Fq "by ${OWNER}"; }

restore_path() {
    local path="$1" stock="$2"
    if ! is_our_diversion "$path"; then return 1; fi
    rm -f -- "$path"
    dpkg-divert --package "$OWNER" --remove --rename --divert "$stock" "$path" >/dev/null
    return 0
}

find_libblockdev_plugin() {
    local candidate
    while IFS= read -r candidate; do
        case "$candidate" in
            */libbd_fs.so.[0-9]*.[0-9]*.[0-9]*)
                if [[ -e "$candidate" || -L "$candidate" ]]; then
                    printf '%s\n' "$candidate"
                    return 0
                fi ;;
        esac
    done < <(dpkg-query -L libblockdev-fs3 2>/dev/null || true)
    return 1
}

repair_legacy() {
    local changed=0 plugin="" line path
    restore_path "$MINT_FORMATTER" "${MINT_FORMATTER}.infiltratorfs-stock" && changed=1 || true
    restore_path "$MINT_UI" "${MINT_UI}.infiltratorfs-stock" && changed=1 || true
    restore_path "$MINT_NEMO_FORMAT" "$MINT_NEMO_FORMAT_STOCK" && changed=1 || true
    rm -f -- "$LEGACY_INFILTRATOR_NEMO_FORMAT"

    plugin="$(find_libblockdev_plugin || true)"
    if [[ -n "$plugin" ]]; then
        restore_path "$plugin" "${plugin}.infiltratorfs-stock" && changed=1 || true
    fi
    while IFS= read -r line; do
        [[ "$line" == *"libbd_fs.so."*" by ${OWNER}"* ]] || continue
        path="${line#diversion of }"
        path="${path%% to *}"
        restore_path "$path" "${path}.infiltratorfs-stock" && changed=1 || true
    done < <(dpkg-divert --list 2>/dev/null || true)
    restore_path "$GDU_TARGET" "${GDU_TARGET}.infiltratorfs-stock" && changed=1 || true

    if command -v systemctl >/dev/null 2>&1; then
        if [[ "$changed" -eq 1 ]] || systemctl is-failed --quiet udisks2.service 2>/dev/null; then
            systemctl reset-failed udisks2.service >/dev/null 2>&1 || true
            systemctl restart udisks2.service >/dev/null 2>&1 || true
        fi
    fi
    if [[ "$changed" -eq 1 ]]; then
        log "legacy system-component diversions removed; distro-owned desktop storage components restored."
    else
        log "no legacy system-component diversions present."
    fi
}

verify_clean() {
    local plugin=""
    ! is_our_diversion "$GDU_TARGET"
    ! is_our_diversion "$MINT_FORMATTER"
    ! is_our_diversion "$MINT_UI"
    ! is_our_diversion "$MINT_NEMO_FORMAT"
    plugin="$(find_libblockdev_plugin || true)"
    [[ -z "$plugin" ]] || ! is_our_diversion "$plugin"
}

case "${1:-}" in
    install|remove|repair-legacy) repair_legacy ;;
    verify) verify_clean ;;
    *) echo 'Usage: infiltratorfs-os-integration {repair-legacy|verify}' >&2; exit 2 ;;
esac
