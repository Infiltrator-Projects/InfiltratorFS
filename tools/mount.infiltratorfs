#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -euo pipefail

usage() {
    echo "Usage: mount.infiltratorfs <image-or-device> <mountpoint> [-r|-w] [-o options]" >&2
}

if (( $# < 2 )); then
    usage
    exit 2
fi

source_path="$1"
mountpoint="$2"
shift 2
fake_mount=0
verbose=0
readonly_mode=""
declare -a option_parts=()

while (( $# > 0 )); do
    case "$1" in
        -o)
            (( $# >= 2 )) || { usage; exit 2; }
            option_parts+=("$2")
            shift 2
            ;;
        -o?*)
            option_parts+=("${1#-o}")
            shift
            ;;
        -r)
            readonly_mode="ro"
            shift
            ;;
        -w)
            readonly_mode="rw"
            shift
            ;;
        -v)
            verbose=1
            shift
            ;;
        -n)
            shift
            ;;
        -f)
            fake_mount=1
            shift
            ;;
        --)
            shift
            (( $# == 0 )) || { usage; exit 2; }
            ;;
        *)
            echo "mount.infiltratorfs: unsupported option: $1" >&2
            usage
            exit 2
            ;;
    esac
done

if (( fake_mount )); then
    exit 0
fi

mount_program="${INFILFS_MOUNT:-/bin/mount}"
modprobe_program="${INFILFS_MODPROBE:-/sbin/modprobe}"
if [[ ! -x "$mount_program" ]]; then
    echo "mount.infiltratorfs: mount utility is unavailable: $mount_program" >&2
    exit 1
fi
if [[ ! -x "$modprobe_program" ]]; then
    echo "mount.infiltratorfs: modprobe is unavailable: $modprobe_program" >&2
    exit 1
fi

"$modprobe_program" infiltratorfs

# Keep loop first for regular images so the command line is deterministic and
# matches util-linux's conventional loop,rw/loop,ro ordering.
if [[ -f "$source_path" && ! -b "$source_path" ]]; then
    option_parts+=("loop")
fi
if [[ -n "$readonly_mode" ]]; then
    option_parts+=("$readonly_mode")
fi

options=""
if (( ${#option_parts[@]} > 0 )); then
    options="$(IFS=,; echo "${option_parts[*]}")"
fi

declare -a args=(-i -t infiltratorfs)
(( verbose )) && args+=(-v)
[[ -n "$options" ]] && args+=(-o "$options")
args+=("$source_path" "$mountpoint")
exec "$mount_program" "${args[@]}"
