def capture(*argv: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(argv, text=True, stdout=subprocess.PIPE,
                          stderr=subprocess.PIPE, check=False)


def human_size(size: int) -> str:
    value = float(max(size, 0))
    for unit in ("B", "KiB", "MiB", "GiB", "TiB", "PiB"):
        if value < 1024 or unit == "PiB":
            return f"{int(value)} B" if unit == "B" else f"{value:.1f} {unit}"
        value /= 1024
    return "—"


def protected_devices() -> set[str]:
    protected: set[str] = set()
    for mountpoint in ("/", "/boot", "/boot/efi"):
        source = capture("findmnt", "-nro", "SOURCE", mountpoint).stdout.strip()
        if not source.startswith("/dev/"):
            continue
        source = os.path.realpath(source)
        protected.add(source)
        for line in capture("lsblk", "-srnpo", "NAME", source).stdout.splitlines():
            if line.strip():
                protected.add(os.path.realpath(line.strip()))
    return protected


def is_sd(parent: str) -> bool:
    name = os.path.basename(parent)
    if not name.startswith("mmcblk"):
        return False
    try:
        card = (Path("/sys/class/block") / name / "device/type").read_text().strip()
        return card in {"SD", "SDIO", "SDcombo"}
    except OSError:
        return False


def media_kind(removable: bool, parent: str, transport: str) -> str:
    if removable:
        return "Removable"
    if transport == "usb":
        return "USB"
    if is_sd(parent):
        return "SD card"
    return "Fixed disk"


def walk(nodes: list[dict]):
    for node in nodes:
        yield node
        yield from walk(node.get("children") or [])


@dataclass
class Target:
    path: str
    kind: str
    name: str
    size: int = 0
    media: str = ""
    filesystem: str = ""
    label: str = ""
    mountpoint: str = ""
    mount_fstype: str = ""

    @property
    def block(self) -> bool:
        return self.kind == "block"


def discover_partitions() -> list[Target]:
    result = capture("lsblk", "-J", "-b", "-o",
                     "NAME,PATH,SIZE,TYPE,RM,PKNAME,TRAN,FSTYPE,LABEL,MOUNTPOINTS")
    if result.returncode:
        raise RuntimeError(result.stderr.strip() or "Could not enumerate storage devices.")
    try:
        nodes = json.loads(result.stdout).get("blockdevices") or []
    except json.JSONDecodeError as exc:
        raise RuntimeError("Storage inventory returned invalid data.") from exc
    protected = protected_devices()
    targets: list[Target] = []
    for node in walk(nodes):
        if node.get("type") != "part":
            continue
        path = str(node.get("path") or "")
        if not path or os.path.realpath(path) in protected:
            continue
        mounts = [x for x in node.get("mountpoints") or [] if x]
        fstype = str(node.get("fstype") or "")
        label = str(node.get("label") or "")
        targets.append(Target(
            path, "block", label or os.path.basename(path), int(node.get("size") or 0),
            media_kind(bool(node.get("rm")), str(node.get("pkname") or ""),
                       str(node.get("tran") or "")),
            fstype, label, str(mounts[0]) if mounts else "", fstype if mounts else "",
        ))
    return targets


def list_partitions() -> int:
    try:
        rows = discover_partitions()
    except RuntimeError as exc:
        print(exc, file=sys.stderr)
        return 1
    for target in rows:
        print("	".join((target.path, str(target.size), target.media,
                         target.filesystem or "-", target.label or "-",
                         target.mountpoint or "-")))
    return 0


def mountpoint_for(target: Target) -> str:
    if target.block:
        return f"/media/{pwd.getpwuid(os.getuid()).pw_name}/InfiltratorFS"
    return str(Path.home() / "InfiltratorFS")


def refresh_mount(target: Target) -> None:
    if target.block:
        result = capture("findmnt", "-rn", "-S", target.path, "-o", "TARGET,FSTYPE")
        parts = result.stdout.strip().split(None, 1) if not result.returncode else []
        target.mountpoint = parts[0] if parts else ""
        target.mount_fstype = parts[1] if len(parts) > 1 else ""
    else:
        mountpoint = mountpoint_for(target)
        if capture("mountpoint", "-q", mountpoint).returncode == 0:
            target.mountpoint = mountpoint
            target.mount_fstype = capture("findmnt", "-nro", "FSTYPE", "-T", mountpoint).stdout.strip()
        else:
            target.mountpoint = target.mount_fstype = ""


def package_version() -> str:
    result = capture("dpkg-query", "-W", "infiltratorfs") if shutil.which("dpkg-query") else None
    if result and not result.returncode and result.stdout.strip():
        parts = result.stdout.strip().split()
        if len(parts) > 1:
            return parts[-1]
    return "source/development"


