        self.spinner.hide()
        self._show_empty_state()

    def _install_css(self):
        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION,
        )

    @staticmethod
    def _icon(name: str, size=Gtk.IconSize.BUTTON) -> Gtk.Image:
        return Gtk.Image.new_from_icon_name(name, size)

    @staticmethod
    def _style(widget, *classes: str):
        context = widget.get_style_context()
        for style_class in classes:
            context.add_class(style_class)
        return widget

    @staticmethod
    def _label(text="", *, xalign=0, style=None) -> Gtk.Label:
        label = Gtk.Label(label=text, xalign=xalign)
        if style:
            label.get_style_context().add_class(style)
        return label

