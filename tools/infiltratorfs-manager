        view.set_right_margin(12)
        view.set_top_margin(10)
        view.set_bottom_margin(10)
        self.buffer = view.get_buffer()
        self.view = view
        scroll.add(view)
        frame.add(scroll)
        page.pack_start(frame, True, True, 0)

    def _build_statusbar(self, root):
        statusbar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self._style(statusbar, "statusbar")
        self.spinner = Gtk.Spinner()
        self.status = self._label("Ready", style="status-text")
        self.version = self._label(f"Version {package_version()}", xalign=1, style="status-text")
        statusbar.pack_start(self.spinner, False, False, 0)
        statusbar.pack_start(self.status, True, True, 0)
        statusbar.pack_end(self.version, False, False, 0)
        root.pack_end(statusbar, False, False, 0)

    def device_row(self, target: Target):
        row = Gtk.ListBoxRow()
        row.target = target

        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=11)
        self._style(box, "device-row")
        icon_name = (
            "drive-removable-media-symbolic"
            if target.media != "Fixed disk"
            else "drive-harddisk-symbolic"
        )
        icon = self._icon(icon_name, Gtk.IconSize.DIALOG)
        icon.set_pixel_size(28)
        box.pack_start(icon, False, False, 0)

        labels = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        name = self._label(target.name, style="device-name")
        name.set_ellipsize(Pango.EllipsizeMode.END)
        sub = self._label(
            f"{target.path}  •  {human_size(target.size)}", style="device-meta"
        )
        sub.set_ellipsize(Pango.EllipsizeMode.END)
        info_text = target.media
        if target.filesystem:
            info_text += f"  •  {target.filesystem}"
        info = self._label(info_text, style="device-meta")
        labels.pack_start(name, False, False, 0)
        labels.pack_start(sub, False, False, 0)
        labels.pack_start(info, False, False, 0)
        box.pack_start(labels, True, True, 0)
        row.add(box)
        return row

    def refresh_devices(self, preserve=True):
        selected = self.target.path if preserve and self.target else ""
        try:
            targets = discover_partitions()
        except RuntimeError as exc:
            self.error(str(exc))
            return

        for child in self.device_list.get_children():
            self.device_list.remove(child)
        self.rows = {}
        for target in targets:
            row = self.device_row(target)
            self.device_list.add(row)
            self.rows[target.path] = row

        count = len(targets)
        self.count.set_text(
            f"{count} available partition{'s' if count != 1 else ''}"
        )
        self.device_list.show_all()

        if selected in self.rows:
            self.device_list.select_row(self.rows[selected])
        elif self.target and not self.target.block:
            self.show_target()
        elif selected:
            self.target = None
            self._show_empty_state()

    def selected(self, _box, row):
        if row is None:
            return
        self.target = row.target
        self.show_target()

    def _show_empty_state(self):
        self.content_stack.set_visible_child_name("empty")
        self.status.set_text("Ready")

    def show_target(self):
        if not self.target:
            self._show_empty_state()
            return

        target = self.target
        refresh_mount(target)
        if not target.block:
            try:
                target.size = os.path.getsize(target.path)
            except OSError:
                target.size = 0
            probe = (
                capture(TOOLS["inspect"], "--udev", target.path)
                if os.path.exists(TOOLS["inspect"])
                else None
            )
            if probe and not probe.returncode:
                fields = dict(
                    line.split("=", 1)
                    for line in probe.stdout.splitlines()
                    if "=" in line
                )
                target.filesystem = fields.get("ID_FS_TYPE", target.filesystem)
                target.label = fields.get("ID_FS_LABEL", target.label)

        self.content_stack.set_visible_child_name("target")
        self.title.set_text(target.label or target.name)
        self.path.set_text(target.path)
        self.icon.set_from_icon_name(
            "drive-harddisk-symbolic" if target.block else "document-open-symbolic",
            Gtk.IconSize.DIALOG,
        )
        self.icon.set_pixel_size(32)

        mounted = bool(target.mountpoint)
        self.mount_badge.set_text("Mounted" if mounted else "Not mounted")
        badge_style = self.mount_badge.get_style_context()
        if mounted:
            badge_style.add_class("badge-mounted")
        else:
            badge_style.remove_class("badge-mounted")

        mount_text = (
            f"Mounted ({target.mount_fstype})" if mounted else "Not mounted"
        )
        filesystem = target.filesystem or "Unknown / unformatted"
        self.stat_values["size"].set_text(human_size(target.size))
        self.stat_values["fs"].set_text(filesystem)
        self.stat_values["mount"].set_text("Mounted" if mounted else "Not mounted")

        self.values["type"].set_text(target.media if target.block else "Image file")
        self.values["path"].set_text(target.path)
        self.values["fs"].set_text(filesystem)
        self.values["label"].set_text(target.label or "—")
        self.values["mount"].set_text(mount_text)
        self.values["mountpoint"].set_text(target.mountpoint or "—")
        self.enable()

    def enable(self):
        available = self.target is not None and not self.busy
        mounted = bool(self.target and self.target.mountpoint)
        for button in (self.inspect, self.scrub, self.forensic):
            button.set_sensitive(available)
        self.format.set_sensitive(available and not mounted)
        self.mount.set_sensitive(available)
        self.unmount.set_sensitive(available and mounted)
        self.mount.set_label("Open in Files" if mounted else "Mount and Open")

    def error(self, text):
        dialog = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            message_type=Gtk.MessageType.ERROR,
            buttons=Gtk.ButtonsType.CLOSE,
            text="Operation failed",
        )
        dialog.format_secondary_text(text)
        dialog.run()
        dialog.destroy()

    def log(self, text):
        end = self.buffer.get_end_iter()
        self.buffer.insert(end, text)
        mark = self.buffer.create_mark(None, self.buffer.get_end_iter(), False)
        self.view.scroll_mark_onscreen(mark)
        self.buffer.delete_mark(mark)
        return False

    def run(self, title, commands, success, after=None, activity=True):
        if self.busy:
            return
        if activity:
            self.page_stack.set_visible_child_name("activity")
        self.log(f"\n── {title} ──\n")
        self.busy = True
        self.spinner.show()
        self.spinner.start()
        self.status.set_text(f"{title}…")
        self.enable()

        def worker():
            failure = ""
            for command in commands:
                GLib.idle_add(self.log, "$ " + " ".join(command) + "\n")
                try:
                    process = subprocess.Popen(
                        command,
                        stdout=subprocess.PIPE,
                        stderr=subprocess.STDOUT,
                        text=True,
                        bufsize=1,
                    )
                except OSError as exc:
                    failure = str(exc)
                    break
                for line in process.stdout or ():
                    GLib.idle_add(self.log, line)
                if process.wait():
                    failure = f"Command exited with status {process.returncode}."
                    break

            def finish():
                self.busy = False
                self.spinner.stop()
                self.spinner.hide()
                self.status.set_text(success if not failure else "Operation failed")
                if failure:
                    self.log("ERROR: " + failure + "\n")
                    self.error(failure)
                else:
                    self.log(success + "\n")
                    if after:
                        after()
                    self.refresh_devices()
                self.enable()
                return False

            GLib.idle_add(finish)

        threading.Thread(target=worker, daemon=True).start()

    def open_image(self, *_):
        dialog = Gtk.FileChooserDialog(
            "Open InfiltratorFS image",
            self,
            Gtk.FileChooserAction.OPEN,
            ("Cancel", Gtk.ResponseType.CANCEL, "Open Image", Gtk.ResponseType.OK),
        )
        response = dialog.run()
        filename = dialog.get_filename()
        dialog.destroy()
        if response != Gtk.ResponseType.OK or not filename:
            return
        if not os.path.isfile(filename):
            self.error("Select a regular image file.")
            return
        self.device_list.unselect_all()
        self.target = Target(
            filename,
            "image",
            os.path.basename(filename),
            os.path.getsize(filename),
            "Image file",
        )
        self.show_target()
        self.page_stack.set_visible_child_name("overview")

    def create_image(self, *_):
        chooser = Gtk.FileChooserDialog(
            "Create InfiltratorFS image",
            self,
            Gtk.FileChooserAction.SAVE,
            ("Cancel", Gtk.ResponseType.CANCEL, "Continue", Gtk.ResponseType.OK),
        )
        chooser.set_do_overwrite_confirmation(True)
        chooser.set_current_name("infiltratorfs.img")
        response = chooser.run()
        filename = chooser.get_filename()
        chooser.destroy()
        if response != Gtk.ResponseType.OK or not filename:
            return

        dialog = Gtk.Dialog(
            "New filesystem image",
            self,
            Gtk.DialogFlags.MODAL,
            ("Cancel", Gtk.ResponseType.CANCEL, "Create Image", Gtk.ResponseType.OK),
        )
        area = dialog.get_content_area()
        area.set_border_width(20)
        area.set_spacing(14)
        area.pack_start(self._label("Image settings", style="section-title"), False, False, 0)
        area.pack_start(
            self._label("Choose the capacity and volume label for the new image.", style="section-subtitle"),
            False,
            False,
            0,
        )
        grid = Gtk.Grid(column_spacing=14, row_spacing=12)
        size = Gtk.SpinButton.new_with_range(16, 1048576, 16)
        size.set_value(512)
        label = Gtk.Entry()
        label.set_text("InfiltratorFS")
        grid.attach(self._label("Capacity (MiB)"), 0, 0, 1, 1)
        grid.attach(size, 1, 0, 1, 1)
        grid.attach(self._label("Volume label"), 0, 1, 1, 1)
        grid.attach(label, 1, 1, 1, 1)
        area.pack_start(grid, False, False, 0)
        dialog.show_all()
        response = dialog.run()
        mib = size.get_value_as_int()
        fslabel = label.get_text().strip()
        dialog.destroy()
        if response != Gtk.ResponseType.OK:
            return
        if not fslabel:
            self.error("The volume label cannot be empty.")
            return

        def after():
            self.device_list.unselect_all()
            self.target = Target(
                filename,
                "image",
                os.path.basename(filename),
                mib * 1024 * 1024,
                "Image file",
                "infiltratorfs",
                fslabel,
            )
            self.show_target()
            self.page_stack.set_visible_child_name("overview")

        self.run(
            "Create image",
            [
                ["truncate", "-s", f"{mib}M", "--", filename],
                [TOOLS["mkfs"], "-L", fslabel, filename],
            ],
            "Image created and formatted successfully.",
            after,
        )

    def ask_label(self):
        dialog = Gtk.Dialog(
            "Format volume",
            self,
            Gtk.DialogFlags.MODAL,
            ("Cancel", Gtk.ResponseType.CANCEL, "Continue", Gtk.ResponseType.OK),
        )
        area = dialog.get_content_area()
        area.set_border_width(20)
        area.set_spacing(12)
        area.pack_start(self._label("Volume label", style="section-title"), False, False, 0)
        area.pack_start(
            self._label("Enter the label for the new InfiltratorFS filesystem.", style="section-subtitle"),
            False,
            False,
            0,
        )
        entry = Gtk.Entry()
        entry.set_activates_default(True)
        entry.set_text(
            self.target.label if self.target and self.target.label else "InfiltratorFS"
        )
        area.pack_start(entry, False, False, 0)
        dialog.set_default_response(Gtk.ResponseType.OK)
        dialog.show_all()
        response = dialog.run()
        value = entry.get_text().strip()
        dialog.destroy()
        return value if response == Gtk.ResponseType.OK else None

    def do_format(self, *_):
        if not self.target:
            return
        self.show_target()
        if self.target.mountpoint:
            self.error("Unmount the selected volume before formatting it.")
            return
        label = self.ask_label()
        if not label:
            return

        dialog = Gtk.MessageDialog(
            transient_for=self,
            modal=True,
            message_type=Gtk.MessageType.WARNING,
            buttons=Gtk.ButtonsType.NONE,
            text="Erase and format this volume?",
        )
        dialog.format_secondary_text(
            f"All existing data on {self.target.path} will be permanently destroyed.\n\nNew volume label: {label}"
        )
        dialog.add_button("Cancel", Gtk.ResponseType.CANCEL)
        erase = dialog.add_button("Erase and Format", Gtk.ResponseType.ACCEPT)
        erase.get_style_context().add_class("destructive-action")
        response = dialog.run()
        dialog.destroy()
        if response != Gtk.ResponseType.ACCEPT:
            return

        command = (
            ["pkexec", HELPER, "format-block", self.target.path, label]
            if self.target.block
            else [TOOLS["mkfs"], "-L", label, self.target.path]
        )

        def after():
            self.target.label = label
            self.target.name = label
            self.target.filesystem = "infiltratorfs"
            self.show_target()
            self.page_stack.set_visible_child_name("overview")

        self.run(
            "Format volume",
            [command],
            "Formatting completed successfully.",
            after,
        )

    def tool_command(self, blockop, tool):
        if not self.target:
            return None
        return (
            ["pkexec", HELPER, blockop, self.target.path]
            if self.target.block
            else [tool, self.target.path]
        )

    def do_inspect(self, *_):
        command = self.tool_command("inspect-block", TOOLS["inspect"])
        if command:
            self.run("Inspect filesystem", [command], "Inspection completed.")

    def do_scrub(self, *_):
        command = self.tool_command("scrub-block", TOOLS["scrub"])
        if command:
            self.run("Verify filesystem", [command], "Integrity check completed.")

    def do_forensic(self, *_):
        command = self.tool_command("forensic-block", TOOLS["forensic"])
        if command:
            self.run("Forensic scan", [command], "Forensic scan completed.")

    def mount_open(self, *_):
        if not self.target:
            return
        self.show_target()
        if self.target.mountpoint:
            subprocess.Popen(
                ["xdg-open", self.target.mountpoint],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            return

        point = mountpoint_for(self.target)
        op = "mount-block" if self.target.block else "mount-image"
        command = [
            "pkexec",
            HELPER,
            op,
            self.target.path,
            str(os.getuid()),
            str(os.getgid()),
            point,
        ]

        def after():
            self.show_target()
            subprocess.Popen(
                ["xdg-open", point],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
            )
            self.page_stack.set_visible_child_name("overview")

        self.run(
            "Mount filesystem",
            [command],
            "Filesystem mounted natively.",
            after,
            False,
        )

    def do_unmount(self, *_):
        if not self.target:
            return
        point = self.target.mountpoint or mountpoint_for(self.target)
        op = "unmount-block" if self.target.block else "unmount-image"
        command = ["pkexec", HELPER, op, str(os.getuid()), point]

        def after():
            self.target.mountpoint = ""
            self.target.mount_fstype = ""
            self.show_target()
            self.page_stack.set_visible_child_name("overview")

        self.run(
            "Unmount filesystem",
            [command],
            "Filesystem unmounted safely.",
            after,
            False,
        )

    def about(self, *_):
        dialog = Gtk.AboutDialog(
            transient_for=self,
            modal=True,
            program_name=APP_NAME,
            version=package_version(),
            comments=(
                "Native Linux management for InfiltratorFS volumes.\n"
                "Uses the native VFS/DKMS driver; FUSE is not the product path."
            ),
            website="https://github.com/Infiltrator-Projects/InfiltratorFS",
            license_type=Gtk.License.GPL_3_0,
        )
        dialog.run()
        dialog.destroy()


class Application(Gtk.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.FLAGS_NONE)

    def do_activate(self):
        window = self.props.active_window or Manager(self)
        window.present()


missing = [
    name
    for name in ("lsblk", "findmnt", "mountpoint", "pkexec", "xdg-open", "truncate")
    if shutil.which(name) is None
]
if missing:
    print(
        f"{APP_NAME}: missing required command(s): {', '.join(missing)}",
        file=sys.stderr,
    )
    raise SystemExit(1)

raise SystemExit(Application().run(sys.argv[:1]))
