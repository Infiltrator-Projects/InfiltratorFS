#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -u

usage() {
    echo "Usage: fsck.infiltratorfs [--scrub] [-afnp] <image-or-device>" >&2
}

declare -a targets=()
deep_scrub=0
while (( $# > 0 )); do
    case "$1" in
        --scrub)
            deep_scrub=1
            shift
            ;;
        -[afnp]*)
            flags="${1#-}"
            if [[ "$flags" == *[^afnp]* ]]; then
                echo "fsck.infiltratorfs: unsupported option: $1" >&2
                usage
                exit 16
            fi
            shift
            ;;
        --)
            shift
            while (( $# > 0 )); do
                targets+=("$1")
                shift
            done
            ;;
        -*)
            echo "fsck.infiltratorfs: unsupported option: $1" >&2
            usage
            exit 16
            ;;
        *)
            targets+=("$1")
            shift
            ;;
    esac
done

if (( ${#targets[@]} != 1 )); then
    usage
    exit 16
fi

if (( deep_scrub )); then
    program="${INFILFS_SCRUB:-/usr/bin/infilfs-scrub}"
    description="scrub utility"
    args=("${targets[0]}")
else
    program="${INFILFS_CHECK:-/usr/bin/infilfs-inspect}"
    description="filesystem checker"
    args=(--check "${targets[0]}")
fi

if [[ ! -x "$program" ]]; then
    echo "fsck.infiltratorfs: $description is unavailable: $program" >&2
    exit 8
fi

"$program" "${args[@]}"
status=$?
case "$status" in
    0) exit 0 ;;
    2) exit 4 ;;
    *) exit 8 ;;
esac
